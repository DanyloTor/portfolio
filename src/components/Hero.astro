---
const base = import.meta.env.BASE_URL;
const ig = 'https://www.instagram.com/crushikme/';
---

<!-- HERO — Editorial / Bold -->
<header id="top" data-screen="hero" style="position:relative;overflow:hidden;background:radial-gradient(130% 110% at 78% -10%, #1c1033 0%, #0e0820 48%, #0A0612 100%);padding:84px 40px 100px;">
  <div style="position:absolute;inset:0;pointer-events:none;">
    <span style="position:absolute;top:18%;left:10%;width:5px;height:5px;border-radius:50%;background:#A855F7;opacity:.6;animation:evfloat 7s ease-in-out infinite;"></span>
    <span style="position:absolute;top:66%;left:18%;width:4px;height:4px;border-radius:50%;background:#FF5C7A;opacity:.5;animation:evfloat 9s ease-in-out .8s infinite;"></span>
    <span style="position:absolute;top:30%;left:42%;width:3px;height:3px;border-radius:50%;background:#C9A9FF;opacity:.4;animation:evfloat 11s ease-in-out .2s infinite;"></span>
    <span style="position:absolute;top:78%;right:30%;width:4px;height:4px;border-radius:50%;background:#FF8AA3;opacity:.5;animation:evfloat 10s ease-in-out 1.2s infinite;"></span>
  </div>
  <div style="position:absolute;top:-140px;right:-60px;width:480px;height:480px;border-radius:50%;background:radial-gradient(circle,rgba(255,92,122,0.20),transparent 65%);pointer-events:none;"></div>
  <div class="ev-hero-inner" style="position:relative;max-width:1180px;margin:0 auto;display:flex;align-items:center;gap:clamp(40px,5vw,72px);flex-wrap:wrap;" data-reveal>
    <div class="ev-hero-text" style="flex:1 1 460px;min-width:300px;">
      <div style="display:inline-flex;align-items:center;gap:8px;padding:7px 16px;border-radius:999px;background:rgba(255,92,122,0.1);border:1px solid rgba(255,92,122,0.3);font:600 11px/1 'Manrope',sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#FF8AA3;margin-bottom:28px;"><span style="width:6px;height:6px;border-radius:50%;background:#FF5C7A;"></span>SMM-агенція повного циклу</div>
      <h1 style="font-family:'Unbounded',sans-serif;font-weight:800;font-size:clamp(42px,5.6vw,74px);line-height:0.98;margin:0 0 22px;letter-spacing:-0.025em;">Робимо контент,<br>що <span style="background:linear-gradient(120deg,#A855F7,#FF5C7A);-webkit-background-clip:text;background-clip:text;color:transparent;">продає</span></h1>
      <p style="font-size:clamp(17px,1.5vw,20px);color:#CFC6E2;margin:0 0 34px;line-height:1.5;max-width:440px;">Єлизавета &amp; Власта — повний цикл SMM від стратегії до воронки продажів у Direct.</p>
      <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
        <a href={ig} target="_blank" rel="noopener noreferrer" class="ev-btn" style="text-decoration:none;display:inline-flex;align-items:center;gap:10px;padding:16px 30px;border-radius:999px;background:linear-gradient(135deg,#A855F7,#FF5C7A);color:#fff;font-weight:700;font-size:16px;box-shadow:0 14px 40px rgba(168,85,247,0.45);">Написати в Direct →</a>
        <a href="#projects" class="ev-btn-ghost" style="text-decoration:none;display:inline-flex;align-items:center;padding:16px 30px;border-radius:999px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.16);color:#F4F1FA;font-weight:600;font-size:16px;">Дивитись портфоліо</a>
      </div>
      <div class="ev-hero-stats" style="display:flex;gap:clamp(28px,4vw,44px);margin-top:42px;">
        <div><div class="ev-count" style="font-family:'Unbounded';font-weight:800;font-size:clamp(28px,3vw,34px);background:linear-gradient(120deg,#A855F7,#FF5C7A);-webkit-background-clip:text;background-clip:text;color:transparent;">1M+</div><div style="font-size:13px;color:#9b91b4;margin-top:4px;">переглядів рілсів</div></div>
        <div><div class="ev-count" style="font-family:'Unbounded';font-weight:800;font-size:clamp(28px,3vw,34px);background:linear-gradient(120deg,#A855F7,#FF5C7A);-webkit-background-clip:text;background-clip:text;color:transparent;">+30K</div><div style="font-size:13px;color:#9b91b4;margin-top:4px;">нових підписників</div></div>
        <div><div class="ev-count" style="font-family:'Unbounded';font-weight:800;font-size:clamp(28px,3vw,34px);background:linear-gradient(120deg,#A855F7,#FF5C7A);-webkit-background-clip:text;background-clip:text;color:transparent;">15+</div><div style="font-size:13px;color:#9b91b4;margin-top:4px;">брендів</div></div>
      </div>
    </div>
    <div class="ev-hero-photos" style="flex:0 0 330px;position:relative;height:430px;margin:0 auto;">
      <div style="position:absolute;top:0;left:34px;width:222px;height:292px;border-radius:22px;padding:3px;background:linear-gradient(135deg,#A855F7,#FF5C7A);transform:rotate(-5deg);box-shadow:0 28px 64px rgba(0,0,0,0.55);">
        <div style="width:100%;height:100%;border-radius:19px;overflow:hidden;">
          <img src={`${base}images/team/vlasta.jpg`} alt="Власта" style="width:100%;height:100%;object-fit:cover;display:block;" />
        </div>
      </div>
      <div style="position:absolute;bottom:0;right:0;width:205px;height:262px;border-radius:22px;padding:3px;background:linear-gradient(135deg,#FF5C7A,#A855F7);transform:rotate(6deg);box-shadow:0 28px 64px rgba(0,0,0,0.55);">
        <div style="width:100%;height:100%;border-radius:19px;overflow:hidden;">
          <img src={`${base}images/team/yelyzaveta.jpg`} alt="Єлизавета" style="width:100%;height:100%;object-fit:cover;display:block;" />
        </div>
      </div>
      <div style="position:absolute;top:46%;left:-26px;background:rgba(13,8,24,0.92);backdrop-filter:blur(8px);border:1px solid rgba(168,85,247,0.4);border-radius:14px;padding:12px 18px;box-shadow:0 14px 34px rgba(0,0,0,0.55);"><div style="font:700 20px 'Unbounded';color:#fff;">+62%</div><div style="font-size:11px;color:#9b91b4;">охоплення</div></div>
    </div>
  </div>
</header>

<!-- TRUST STRIP -->
<div style="border-top:1px solid rgba(168,85,247,0.1);border-bottom:1px solid rgba(168,85,247,0.1);background:rgba(255,255,255,0.015);">
  <div class="ev-trust" style="max-width:1200px;margin:0 auto;padding:26px 40px;display:flex;align-items:center;justify-content:center;gap:clamp(20px,5vw,64px);flex-wrap:wrap;">
    <span style="font:600 12px 'Manrope';letter-spacing:.16em;text-transform:uppercase;color:#7E7593;">Нам довіряють</span>
    <span style="color:#CFC6E2;font-weight:600;font-size:15px;">Кав'ярні</span>
    <span style="width:5px;height:5px;border-radius:50%;background:#A855F7;"></span>
    <span style="color:#CFC6E2;font-weight:600;font-size:15px;">Ресторани</span>
    <span style="width:5px;height:5px;border-radius:50%;background:#FF5C7A;"></span>
    <span style="color:#CFC6E2;font-weight:600;font-size:15px;">Магазини одягу</span>
    <span style="width:5px;height:5px;border-radius:50%;background:#A855F7;"></span>
    <span style="color:#CFC6E2;font-weight:600;font-size:15px;">Локальні бренди</span>
  </div>
</div>
