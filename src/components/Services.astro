---
const services = [
  { n: '01', title: 'Контент-стратегія', desc: 'Аналіз ніші, конкурентів і ЦА — план, що веде до продажів' },
  { n: '02', title: 'Фото / Відеозйомка', desc: 'Зйомка reels та контенту на профі-обладнання' },
  { n: '03', title: 'Дизайн контенту', desc: 'Сторіс, обкладинки та візуал у єдиному стилі бренду' },
  { n: '04', title: 'Ведення акаунтів', desc: 'Повне ведення: від ідеї до публікації та аналітики' },
];
---

<!-- SERVICES -->
<section id="services" data-screen="services" style="padding:110px 40px;background:radial-gradient(120% 80% at 50% 0%, #100a1e 0%, #0A0612 60%);">
  <div style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;max-width:680px;margin:0 auto 56px;" data-reveal>
      <div style="display:inline-flex;align-items:center;gap:8px;padding:7px 16px;border-radius:999px;background:rgba(168,85,247,0.08);border:1px solid rgba(168,85,247,0.26);font:600 11px/1 'Manrope';letter-spacing:.2em;text-transform:uppercase;color:#C9A9FF;margin-bottom:22px;">Послуги</div>
      <h2 style="font-family:'Unbounded';font-weight:700;font-size:clamp(32px,4.4vw,54px);line-height:1.06;margin:0;letter-spacing:-0.02em;">Повний цикл проєкту під ключ</h2>
    </div>
    <div style="display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;margin-bottom:48px;" data-reveal>
      <div class="ev-chip" style="display:inline-flex;align-items:center;gap:10px;padding:13px 22px;border-radius:14px;background:rgba(168,85,247,0.1);border:1px solid rgba(168,85,247,0.3);"><span style="font:800 14px 'Unbounded';color:#FF5C7A;">01</span><span style="font-weight:600;font-size:15px;color:#F4F1FA;">Аналіз ЦА</span></div>
      <span style="color:#6f5e8c;">→</span>
      <div class="ev-chip" style="display:inline-flex;align-items:center;gap:10px;padding:13px 22px;border-radius:14px;background:rgba(168,85,247,0.1);border:1px solid rgba(168,85,247,0.3);"><span style="font:800 14px 'Unbounded';color:#FF5C7A;">02</span><span style="font-weight:600;font-size:15px;color:#F4F1FA;">Стратегія</span></div>
      <span style="color:#6f5e8c;">→</span>
      <div class="ev-chip" style="display:inline-flex;align-items:center;gap:10px;padding:13px 22px;border-radius:14px;background:rgba(168,85,247,0.1);border:1px solid rgba(168,85,247,0.3);"><span style="font:800 14px 'Unbounded';color:#FF5C7A;">03</span><span style="font-weight:600;font-size:15px;color:#F4F1FA;">Контент</span></div>
      <span style="color:#6f5e8c;">→</span>
      <div class="ev-chip ev-chip-pink" style="display:inline-flex;align-items:center;gap:10px;padding:13px 22px;border-radius:14px;background:rgba(255,92,122,0.12);border:1px solid rgba(255,92,122,0.35);"><span style="font:800 14px 'Unbounded';color:#FF5C7A;">04</span><span style="font-weight:600;font-size:15px;color:#F4F1FA;">Воронка продажів</span></div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;" data-reveal>
      {services.map((s) => (
        <div class="ev-card-soft" style="border-radius:20px;background:linear-gradient(180deg,#130c22,#0d0818);border:1px solid rgba(255,255,255,0.06);padding:30px;">
          <div class="ev-icon" style="width:48px;height:48px;border-radius:13px;background:linear-gradient(135deg,#A855F7,#FF5C7A);display:flex;align-items:center;justify-content:center;font:800 18px 'Unbounded';color:#fff;margin-bottom:20px;">{s.n}</div>
          <h3 style="font-family:'Unbounded';font-weight:600;font-size:18px;margin:0 0 10px;letter-spacing:-0.01em;">{s.title}</h3>
          <p style="margin:0;color:#9b91b4;font-size:14px;line-height:1.55;">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
