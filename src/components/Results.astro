---
const stats = [
  { num: '1M+', label: 'переглядів рілсів' },
  { num: '650K', label: 'охоплення' },
  { num: '+30K', label: 'нових підписників' },
];
const equipment = [
  { name: 'Камера Canon', tag: 'Hardware' },
  { name: 'DJI Mic Mini', tag: 'Hardware' },
  { name: 'iPhone 15 Pro', tag: 'Hardware' },
  { name: 'Canva', tag: 'Software' },
  { name: 'CapCut', tag: 'Software' },
];
---

<!-- RESULTS -->
<section id="results" data-screen="results" style="padding:110px 40px;background:radial-gradient(120% 90% at 50% 0%, #160b29 0%, #0A0612 55%);">
  <div style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;max-width:720px;margin:0 auto 64px;" data-reveal>
      <div style="display:inline-flex;align-items:center;gap:8px;padding:7px 16px;border-radius:999px;background:rgba(255,92,122,0.1);border:1px solid rgba(255,92,122,0.3);font:600 11px/1 'Manrope';letter-spacing:.2em;text-transform:uppercase;color:#FF8AA3;margin-bottom:22px;">Результати</div>
      <h2 style="font-family:'Unbounded';font-weight:700;font-size:clamp(32px,4.4vw,54px);line-height:1.06;margin:0 0 14px;letter-spacing:-0.02em;">Віральний контент — результати</h2>
      <p style="color:#B7AECB;font-size:18px;margin:0;">Ми знаємо алгоритми віральності — і застосовуємо їх системно</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px;margin-bottom:80px;" data-reveal>
      {stats.map((st) => (
        <div style="text-align:center;border-radius:20px;background:rgba(255,255,255,0.02);border:1px solid rgba(168,85,247,0.14);padding:40px 24px;">
          <div class="ev-count" style="font-family:'Unbounded';font-weight:800;font-size:clamp(44px,5vw,64px);background:linear-gradient(120deg,#A855F7,#FF5C7A);-webkit-background-clip:text;background-clip:text;color:transparent;line-height:1;">{st.num}</div>
          <div style="width:38px;height:3px;border-radius:2px;background:linear-gradient(90deg,#A855F7,#FF5C7A);margin:18px auto 14px;"></div>
          <div style="color:#B7AECB;font-size:15px;font-weight:500;">{st.label}</div>
        </div>
      ))}
    </div>

    <div style="text-align:center;margin-bottom:40px;" data-reveal>
      <h3 style="font-family:'Unbounded';font-weight:700;font-size:clamp(26px,3vw,38px);margin:0;letter-spacing:-0.02em;">Формати та типи контенту</h3>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;" data-reveal>
      <div class="ev-card-soft" style="border-radius:20px;background:linear-gradient(180deg,#130c22,#0d0818);border:1px solid rgba(255,255,255,0.06);border-top:2px solid #A855F7;padding:32px;">
        <div class="ev-icon" style="width:46px;height:46px;border-radius:13px;background:rgba(168,85,247,0.16);display:flex;align-items:center;justify-content:center;margin-bottom:20px;"><span style="width:18px;height:18px;border-radius:5px;background:linear-gradient(135deg,#A855F7,#7C3AED);"></span></div>
        <h4 style="font-family:'Unbounded';font-weight:600;font-size:19px;margin:0 0 10px;">Backstage &amp; Product</h4>
        <p style="margin:0;color:#9b91b4;font-size:14px;line-height:1.55;">Живий контент про продукт та команду, що будує довіру</p>
      </div>
      <div class="ev-card-soft" style="border-radius:20px;background:linear-gradient(180deg,#130c22,#0d0818);border:1px solid rgba(255,255,255,0.06);border-top:2px solid #FF5C7A;padding:32px;">
        <div class="ev-icon" style="width:46px;height:46px;border-radius:13px;background:rgba(255,92,122,0.16);display:flex;align-items:center;justify-content:center;margin-bottom:20px;"><span style="width:18px;height:18px;border-radius:50%;background:linear-gradient(135deg,#FF5C7A,#FF8AA3);"></span></div>
        <h4 style="font-family:'Unbounded';font-weight:600;font-size:19px;margin:0 0 10px;">Atmospheric</h4>
        <p style="margin:0;color:#9b91b4;font-size:14px;line-height:1.55;">Естетика, яка продає та формує впізнаваний образ бренду</p>
      </div>
      <div class="ev-card-soft" style="border-radius:20px;background:linear-gradient(180deg,#130c22,#0d0818);border:1px solid rgba(255,255,255,0.06);border-top:2px solid #6EE7C8;padding:32px;">
        <div class="ev-icon" style="width:46px;height:46px;border-radius:13px;background:rgba(110,231,200,0.14);display:flex;align-items:center;justify-content:center;margin-bottom:20px;"><span style="width:0;height:0;border-left:9px solid transparent;border-right:9px solid transparent;border-top:16px solid #6EE7C8;"></span></div>
        <h4 style="font-family:'Unbounded';font-weight:600;font-size:19px;margin:0 0 10px;">Воронки</h4>
        <p style="margin:0;color:#9b91b4;font-size:14px;line-height:1.55;">Шлях клієнта від перегляду reels до покупки в Direct</p>
      </div>
    </div>

    <div style="text-align:center;margin:80px 0 32px;" data-reveal>
      <h3 style="font-family:'Unbounded';font-weight:700;font-size:clamp(24px,2.8vw,34px);margin:0 0 12px;letter-spacing:-0.02em;">Наша система та обладнання</h3>
      <p style="color:#9b91b4;font-size:16px;max-width:560px;margin:0 auto;line-height:1.55;">Переносимо відпрацьовану систему на вашу нішу — прогнозований результат, а не випадкові перегляди</p>
    </div>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;" data-reveal>
      {equipment.map((e) => (
        <div class="ev-chip" style="display:inline-flex;align-items:center;gap:12px;padding:16px 22px;border-radius:14px;background:rgba(255,255,255,0.025);border:1px solid rgba(255,255,255,0.08);">
          <span style="font-weight:700;font-size:15px;color:#F4F1FA;">{e.name}</span>
          <span style="font:600 10px 'Manrope';letter-spacing:.08em;text-transform:uppercase;color:#9b91b4;background:rgba(168,85,247,0.12);padding:4px 9px;border-radius:999px;">{e.tag}</span>
        </div>
      ))}
    </div>
  </div>
</section>
