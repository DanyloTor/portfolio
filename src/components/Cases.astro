---
const base = import.meta.env.BASE_URL;
const cases = [
  {
    name: 'Coffee Place №1',
    handle: '@coffeeplace___1',
    tag: "Кав'ярня",
    metric: '2 900',
    caption: 'підписники · стабільний ріст охоплення за 2 місяці',
    image: `${base}images/projects/coffee-place.png`,
    instagram: 'https://www.instagram.com/coffeeplace___1/',
  },
  {
    name: 'Затишний дім',
    handle: '@zatyshnyjdim.official',
    tag: 'Ресторан',
    metric: '2 200',
    caption: 'підписники · брони столиків зі сторіс',
    image: `${base}images/projects/zatyshnyi-dim.png`,
    instagram: 'https://www.instagram.com/zatyshnyjdim.official/',
  },
  {
    name: 'Бюстьє',
    handle: '@biustie',
    tag: 'Магазин білизни',
    metric: '53.2K',
    caption: 'підписників · черга замовлень у Direct',
    image: `${base}images/projects/biustie.png`,
    instagram: 'https://www.instagram.com/biustie/',
  },
  {
    name: 'Food Place №1',
    handle: '@foodplace___1',
    tag: 'Кафе',
    metric: '1 500',
    caption: 'підписників · зростання залученості та запитів',
    image: `${base}images/projects/food-place.png`,
    instagram: 'https://www.instagram.com/foodplace___1/',
  },
];
---

<!-- PROJECTS -->
<section id="projects" data-screen="projects" style="padding:110px 40px;">
  <div style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;max-width:680px;margin:0 auto 56px;" data-reveal>
      <div style="display:inline-flex;align-items:center;gap:8px;padding:7px 16px;border-radius:999px;background:rgba(168,85,247,0.08);border:1px solid rgba(168,85,247,0.26);font:600 11px/1 'Manrope';letter-spacing:.2em;text-transform:uppercase;color:#C9A9FF;margin-bottom:22px;">Портфоліо</div>
      <h2 style="font-family:'Unbounded';font-weight:700;font-size:clamp(32px,4.4vw,54px);line-height:1.06;margin:0 0 14px;letter-spacing:-0.02em;">Наші проєкти</h2>
      <p style="color:#B7AECB;font-size:18px;margin:0;">Реальні бізнеси — реальні цифри росту</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;" data-reveal>
      {cases.map((c, i) => (
        <div class="ev-card-lift" style="border-radius:22px;background:linear-gradient(180deg,#130c22,#0d0818);border:1px solid rgba(255,255,255,0.06);overflow:hidden;">
          <div style="padding:26px 26px 22px;display:flex;align-items:center;gap:16px;border-bottom:1px solid rgba(255,255,255,0.06);">
            <div style={`width:54px;height:54px;border-radius:50%;overflow:hidden;flex:0 0 54px;border:1px solid ${i % 2 === 0 ? 'rgba(168,85,247,0.3)' : 'rgba(255,92,122,0.3)'};`}>
              <img src={c.image} alt={c.name} style="width:100%;height:100%;object-fit:cover;display:block;" />
            </div>
            <div style="min-width:0;"><div style="font-weight:700;font-size:17px;">{c.name}</div><div style="font-size:13px;color:#9b91b4;">{c.handle}</div></div>
            <span style={`margin-left:auto;font:600 10px 'Manrope';letter-spacing:.1em;text-transform:uppercase;white-space:nowrap;color:${i % 2 === 0 ? '#C9A9FF' : '#FF8AA3'};background:${i % 2 === 0 ? 'rgba(168,85,247,0.14)' : 'rgba(255,92,122,0.14)'};padding:5px 11px;border-radius:999px;`}>{c.tag}</span>
          </div>
          <div style="padding:26px;">
            <div class="ev-count" style="font-family:'Unbounded';font-weight:800;font-size:36px;background:linear-gradient(120deg,#A855F7,#FF5C7A);-webkit-background-clip:text;background-clip:text;color:transparent;line-height:1;">{c.metric}</div>
            <div style="color:#9b91b4;font-size:14px;margin-top:6px;">{c.caption}</div>
            <a href={c.instagram} target="_blank" rel="noopener noreferrer" style="text-decoration:none;display:inline-flex;align-items:center;gap:7px;margin-top:22px;color:#FF8AA3;font-weight:600;font-size:14px;">Дивитись в Instagram <span class="ev-arrow">↗</span></a>
          </div>
        </div>
      ))}
    </div>

    <div data-reveal style="margin-top:32px;border-radius:24px;padding:1px;background:linear-gradient(120deg,rgba(168,85,247,0.4),rgba(255,92,122,0.4));">
      <div style="border-radius:23px;background:linear-gradient(180deg,#130c22,#0d0818);padding:44px clamp(28px,5vw,64px);text-align:center;">
        <div style="font-family:'Unbounded';font-size:48px;color:#FF5C7A;line-height:0.5;margin-bottom:8px;">“</div>
        <p style="font-size:clamp(19px,2.4vw,26px);line-height:1.5;font-weight:600;margin:0 auto 24px;max-width:760px;color:#F4F1FA;">Дівчата зайшли в наш проєкт як свій. За два місяці reels почали залітати, а в Direct з'явилися реальні замовлення.</p>
        <div style="color:#9b91b4;font-size:14px;font-weight:600;">— власник Food Place №1</div>
      </div>
    </div>
  </div>
</section>
