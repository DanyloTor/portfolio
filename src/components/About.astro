---
const base = import.meta.env.BASE_URL;
---

<!-- ABOUT -->
<section id="about" data-screen="about" style="padding:110px 40px;">
  <div style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;max-width:680px;margin:0 auto 64px;" data-reveal>
      <div style="display:inline-flex;align-items:center;gap:8px;padding:7px 16px;border-radius:999px;background:rgba(168,85,247,0.08);border:1px solid rgba(168,85,247,0.26);font:600 11px/1 'Manrope';letter-spacing:.2em;text-transform:uppercase;color:#C9A9FF;margin-bottom:22px;">Про нас</div>
      <h2 style="font-family:'Unbounded';font-weight:700;font-size:clamp(32px,4.4vw,54px);line-height:1.06;margin:0 0 18px;letter-spacing:-0.02em;">Хто ми та що пропонуємо</h2>
      <p style="color:#B7AECB;font-size:18px;line-height:1.6;margin:0;">Ми не просто знімаємо відео — ми впроваджуємо чітку систему, яка перетворює глядачів на клієнтів.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:28px;" data-reveal>
      <div class="ev-card-lift" style="border-radius:24px;padding:1px;background:linear-gradient(135deg,rgba(168,85,247,0.5),rgba(255,92,122,0.15),transparent);">
        <div class="ev-about-card" style="border-radius:23px;background:linear-gradient(180deg,#130c22,#0d0818);padding:38px;height:100%;box-sizing:border-box;">
          <div class="ev-about-head" style="display:flex;align-items:center;gap:22px;margin-bottom:26px;">
            <div class="ev-about-avatar" style="width:96px;height:96px;flex:0 0 96px;border-radius:50%;padding:3px;background:linear-gradient(135deg,#A855F7,#FF5C7A);">
              <div style="width:100%;height:100%;border-radius:50%;overflow:hidden;">
                <img src={`${base}images/team/yelyzaveta.jpg`} alt="Єлизавета" style="width:100%;height:100%;object-fit:cover;display:block;" />
              </div>
            </div>
            <div>
              <h3 class="ev-about-name" style="font-family:'Unbounded';font-weight:700;font-size:26px;margin:0 0 6px;">Єлизавета</h3>
              <div style="color:#C9A9FF;font-weight:600;font-size:14px;">Контент-стратег · копірайтер · сценарист</div>
            </div>
          </div>
          <p style="margin:0;color:#B7AECB;font-size:16px;line-height:1.6;font-style:italic;border-left:2px solid rgba(255,92,122,0.5);padding-left:16px;">«Кожне слово має працювати на результат»</p>
        </div>
      </div>
      <div class="ev-card-lift" style="border-radius:24px;padding:1px;background:linear-gradient(135deg,rgba(255,92,122,0.5),rgba(168,85,247,0.15),transparent);">
        <div class="ev-about-card" style="border-radius:23px;background:linear-gradient(180deg,#130c22,#0d0818);padding:38px;height:100%;box-sizing:border-box;">
          <div class="ev-about-head" style="display:flex;align-items:center;gap:22px;margin-bottom:26px;">
            <div class="ev-about-avatar" style="width:96px;height:96px;flex:0 0 96px;border-radius:50%;padding:3px;background:linear-gradient(135deg,#FF5C7A,#A855F7);">
              <div style="width:100%;height:100%;border-radius:50%;overflow:hidden;">
                <img src={`${base}images/team/vlasta.jpg`} alt="Власта" style="width:100%;height:100%;object-fit:cover;display:block;" />
              </div>
            </div>
            <div>
              <h3 class="ev-about-name" style="font-family:'Unbounded';font-weight:700;font-size:26px;margin:0 0 6px;">Власта</h3>
              <div style="color:#C9A9FF;font-weight:600;font-size:14px;">Дизайнер · сторісмейкер · візуальний стратег</div>
            </div>
          </div>
          <p style="margin:0;color:#B7AECB;font-size:16px;line-height:1.6;font-style:italic;border-left:2px solid rgba(168,85,247,0.5);padding-left:16px;">«Естетика — це перше враження, яке продає»</p>
        </div>
      </div>
    </div>
  </div>
</section>
