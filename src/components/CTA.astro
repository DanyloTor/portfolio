---
const ig = 'https://www.instagram.com/crushikme/';
---

<!-- FINAL CTA -->
<section class="ev-final-pad" style="padding:40px 40px 110px;">
  <div style="max-width:1000px;margin:0 auto;border-radius:28px;padding:1px;background:linear-gradient(120deg,#A855F7,#FF5C7A);" data-reveal>
    <div class="ev-final-card" style="border-radius:27px;background:radial-gradient(120% 130% at 50% 0%, #2a1148 0%, #1a0c2e 70%);padding:clamp(48px,7vw,84px) 40px;text-align:center;position:relative;overflow:hidden;">
      <div style="position:absolute;top:-40%;right:-10%;width:340px;height:340px;border-radius:50%;background:radial-gradient(circle,rgba(255,92,122,0.25),transparent 65%);pointer-events:none;"></div>
      <h2 style="position:relative;font-family:'Unbounded';font-weight:800;font-size:clamp(28px,4.6vw,56px);line-height:1.05;margin:0 0 18px;letter-spacing:-0.02em;overflow-wrap:break-word;">Готові масштабувати<br>ваш бізнес?</h2>
      <p style="position:relative;color:#D6CCEA;font-size:18px;margin:0 0 38px;">Напишіть нам — і ми безкоштовно розберемо вашу стратегію</p>
      <a href={ig} target="_blank" rel="noopener noreferrer" class="ev-btn-white" style="position:relative;text-decoration:none;display:inline-flex;align-items:center;gap:10px;padding:18px 38px;border-radius:999px;background:#fff;color:#1a0c2e;font-weight:800;font-size:17px;box-shadow:0 16px 44px rgba(0,0,0,0.4);">Написати в Instagram Direct →</a>
    </div>
  </div>
</section>
